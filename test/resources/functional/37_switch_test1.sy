int testSwitch() {
    int x;
    x = 2;
    int result;
    result = 0;
    
    switch (x) {
        case 1:
            result = 100;
            break;
        case 2:
            result = 200;
            break;
        case 3:
            result = 300;
            break;
        default:
            result = 999;
    }
    
    return result;
}

int main() {
    return testSwitch();
}