struct Vec3 {
    float x;
    float y;
    float z;
};

int main() {
    float pi = 3.14f;
    
    float* ptr = &pi;
    *ptr = 2.71f;
    
    struct Vec3 v;
    v.x = 1.0f;
    v.y = 2.0f;
    v.z = *ptr;
    
    int i;
    float sum = 0.0f;
    for (i = 0; i < 3; i = i + 1) {
        sum = sum + v.x;
    }
    
    int result;
    switch (i) {
        case 3:
            result = (int)(sum + v.y);
            break;
        default:
            result = 0;
    }
    
    return result;
}
