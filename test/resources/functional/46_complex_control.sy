int main() {
    int result = 0;
    
    for (int i = 0; i < 10; i = i + 1) {
        switch (i) {
            case 0:
            case 1:
                result = result + 1;
                break;
            case 2:
                if (result > 0) {
                    continue;
                }
                result = result + 10;
                break;
            case 3:
            case 4:
            case 5:
                result = result + 5;
                break;
            default:
                if (i > 7) {
                    break;
                }
                result = result + 2;
        }
    }
    
    return result;
}
