int testSwitchBreak() {
    int x = 2;
    int result = 0;
    
    switch (x) {
        case 1:
            result = 100;
            break;
        case 2:
            result = 200;
            if (result > 100) {
                break;
            }
            result = 999;
            break;
        case 3:
            result = 300;
            break;
    }
    
    return result;
}

int main() {
    return testSwitchBreak();
}
